<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:padding="@dimen/padding_6">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        android:text="Seven RPG"
        android:textColor="@color/primary_500"
        android:textSize="@dimen/text_6xl"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_new_game"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_h_md"
        android:layout_marginHorizontal="@dimen/space_4"
        android:text="بدء لعبة جديدة"
        android:textSize="@dimen/text_lg"
        android:textStyle="bold"
        android:backgroundTint="@color/primary_500"
        android:textColor="#ffffff"
        android:minHeight="@dimen/min_touch"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_load_save"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_h_md"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_marginTop="@dimen/space_4"
        android:text="تحميل حفظ"
        android:textSize="@dimen/text_lg"
        android:textStyle="bold"
        android:backgroundTint="@android:color/transparent"
        android:textColor="@color/primary_600"
        android:minHeight="@dimen/min_touch"
        app:layout_constraintTop_toBottomOf="@id/btn_new_game"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_ai_settings"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_h_md"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_marginTop="@dimen/space_4"
        android:text="إعداد اتصال الذكاء الاصطناعي"
        android:textSize="@dimen/text_base"
        android:backgroundTint="@android:color/transparent"
        android:textColor="@color/primary_600"
        android:minHeight="@dimen/min_touch"
        app:layout_constraintTop_toBottomOf="@id/btn_load_save"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>