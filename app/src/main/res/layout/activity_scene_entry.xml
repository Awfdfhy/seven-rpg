<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:padding="@dimen/space_6">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="المشهد"
        android:textColor="@color/primary_500"
        android:textSize="@dimen/text_3xl"
        android:textStyle="bold"
        android:fontFamily="@font/rakkas"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/narrative_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_6"
        android:layout_marginHorizontal="@dimen/space_4"
        android:elevation="4dp"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardBackgroundColor="@color/surface_panel_light">

        <TextView
            android:id="@+id/narrative_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_6"
            android:text="تستيقظ في غابة مظلمة. الأشجار المحيطة بك تحكي بأسرار قديمة، والهواء البارد يلمس بشرتك. أمامك ثلاثة طرق: طريق يؤدي إلى مدينة مضيئة في الأفق، وطريق يؤدي إلى كهف غامض، وطريق يؤدي إلى نهر هادئ."
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_xl"
            android:fontFamily="@font/rakkas"
            android:lineSpacingExtra="4sp"
            android:gravity="end"
            android:layout_gravity="end" />

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_back_to_world"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_h_md"
        android:layout_marginHorizontal="@dimen/space_4"
        android:text="العودة للعالم"
        android:textSize="@dimen/text_lg"
        android:textStyle="bold"
        android:backgroundTint="@android:color/transparent"
        android:textColor="@color/primary_600"
        android:minHeight="@dimen/min_touch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_submit_action"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_h_md"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_4"
        android:text="إجراء إجراء"
        android:textSize="@dimen/text_lg"
        android:textStyle="bold"
        android:backgroundTint="@color/primary_500"
        android:textColor="#ffffff"
        android:minHeight="@dimen/min_touch"
        app:layout_constraintBottom_toTopOf="@id/btn_back_to_world"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>