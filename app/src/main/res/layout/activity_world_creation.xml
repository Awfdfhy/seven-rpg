<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:padding="@dimen/space_6">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إنشاء عالم جديد"
        android:textColor="@color/primary_500"
        android:textSize="@dimen/text_3xl"
        android:textStyle="bold"
        android:fontFamily="@font/rakkas"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/form_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:layout_marginHorizontal="@dimen/space_4"
        android:elevation="4dp"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardBackgroundColor="@color/surface_panel_light">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_6">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/world_name_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_5">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_world_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_h_md"
                    android:hint="أدخل اسم العالم…"
                    android:textSize="@dimen/text_base"
                    android:gravity="end"
                    android:maxLength="30"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_create_world"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_h_md"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_marginTop="@dimen/space_6"
        android:text="إنشاء العالم"
        android:textSize="@dimen/text_lg"
        android:textStyle="bold"
        android:backgroundTint="@color/primary_500"
        android:textColor="#ffffff"
        android:minHeight="@dimen/min_touch"
        android:enabled="false"
        app:layout_constraintTop_toBottomOf="@id/form_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_cancel"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_h_md"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_marginTop="@dimen/space_4"
        android:text="إلغاء"
        android:textSize="@dimen/text_lg"
        android:textStyle="bold"
        android:backgroundTint="@android:color/transparent"
        android:textColor="@color/primary_600"
        android:minHeight="@dimen/min_touch"
        app:layout_constraintTop_toBottomOf="@id/btn_create_world"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>